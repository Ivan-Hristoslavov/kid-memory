generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  CREATED
  GENERATING
  PREVIEW_READY
  CONFIRMED
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductType {
  DIGITAL
  POSTER_A4
  POSTER_A3
  PREMIUM
}

enum Courier {
  ECONT
  SPEEDY
}

enum DeliveryMethod {
  OFFICE
  ADDRESS
  LOCKER
}

enum Gender {
  BOY
  GIRL
}

/// What kind of poster an order is.
///
/// The shop started as children-only, which capped it to a handful of dates a
/// year. A template decides what the wizard asks for, what the AI is told to
/// draw, and which occasions the poster is sold against — everything else
/// (photo, styles, printing, delivery) is shared.
///
/// KID_WORDS is the original product and stays the default so every existing
/// order keeps its meaning without a data migration.
enum PosterTemplate {
  /// Дете + бисери (грешно казани думички).
  KID_WORDS
  /// Всеки човек + негови реплики — колега, приятел, учител, шеф.
  PORTRAIT_LINES
  /// Двойка + общи реплики — годишнина, сватба, Свети Валентин.
  COUPLE
  /// Домашен любимец + характерни му неща.
  PET
  /// Новородено + данни от раждането.
  BABY_STATS
}

enum PaymentMethod {
  COD
  STRIPE
  REVOLUT
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber Int         @unique @default(autoincrement())
  status      OrderStatus @default(CREATED)

  /// Which poster this is. Drives the wizard, the prompt and the emails.
  template PosterTemplate @default(KID_WORDS)

  // Poster input
  childName   String // combined label for title/emails (e.g. "Мила и Борис")
  /// Age of the first subject. Null on templates that have no age (a colleague
  /// is not asked how old they are, a dog's age is optional).
  childAge    Float?
  /// Gender of the first subject. Null wherever the template doesn't ask.
  childGender Gender?
  /// LEGACY, KID_WORDS only: [{ name, age, gender, words: [{word, saidAs}] }].
  /// Read through `orderSubjects()` — never directly.
  children    Json     @default("[]")
  /// Canonical, template-agnostic subject data:
  /// [{ name, age?, gender?, relation?, species?, lines: [{text, sub?, visual?}] }]
  /// Empty on orders placed before templates existed; `orderSubjects()` maps
  /// `children` across for those.
  subjects    Json     @default("[]")
  photoKey    String? // private storage key of uploaded photo
  /// What the vision pre-pass saw in the photo, captured at upload:
  /// { faces, subjects: [{ position, kind, features, hair, clothing, glasses }] }.
  /// Null on orders whose photo predates the pre-pass or whose reading failed —
  /// generation falls back to the generic identity lock for those.
  photoDescription Json?
  words       Json // flattened [{ word, saidAs }] across all subjects
  animals     String[]
  style       String

  // Product & payment
  productType   ProductType?
  addons        String[] // selected add-on ids (FRAME, PHOTO_PAPER, GIFT_WRAP)
  priceEUR      Decimal?      @db.Decimal(10, 2) // total incl. add-ons
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)

  /// Captured before generation so an abandoned poster can be recovered.
  leadEmail    String?

  /// Set once the recovery email for an abandoned poster has gone out.
  recoveryEmailAt DateTime?

  /// Stamped when the post-delivery review request goes out, so it fires once.
  reviewRequestAt DateTime?

  /// Explicit consent for seasonal campaign emails. Separate from the
  /// transactional mail a customer gets regardless — never assume it.
  marketingOptIn Boolean @default(false)

  /// Optional. Drives a reminder three weeks before the next birthday, which is
  /// the only occasion spread evenly across the year.
  childBirthday       DateTime?
  birthdayReminderAt  DateTime?

  /// One-click confirmation from the order email. Nothing goes to print until
  /// `confirmedAt` is set — an unclaimed personalised parcel is a total loss.
  confirmToken String?   @unique
  confirmedAt  DateTime?

  /// What the AI generations for this order actually cost us, so margin is
  /// visible per order instead of only as a monthly API bill.
  aiCostEUR   Decimal? @db.Decimal(10, 4)
  /// Number of generations, including regenerations and failed attempts.
  aiRuns      Int      @default(0)

  // Customer (guest checkout — filled at /order)
  customerName String?
  phone        String?
  email        String?
  city         String?
  address      String?

  // Delivery
  courier        Courier?
  deliveryMethod DeliveryMethod?
  courierOffice  String?
  trackingNumber String?

  // Generated assets (private storage keys, never public URLs)
  previewImage String?
  finalImage   String?
  finalPdf     String?

  emailsSent Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([template, createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Customer review — submitted publicly, shown on the site only once approved.
model Review {
  id          String       @id @default(cuid())
  authorName  String
  city        String?
  rating      Int // 1..5
  text        String
  status      ReviewStatus @default(PENDING)
  orderNumber Int? // optional link to a real order, for verification
  featured    Boolean      @default(false)
  adminNote   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
}

/// Phone numbers that refused a cash-on-delivery parcel. A personalised poster
/// that comes back cannot be resold, so a repeat offender must be flagged at
/// checkout rather than quietly costing us a second parcel.
model BlockedPhone {
  /// Digits only, no country prefix — matching is done on the last 8.
  phone     String   @id
  reason    String?
  orderRef  Int?
  createdAt DateTime @default(now())
}

/// Audit trail for admin actions on an order.
model AdminLog {
  id        String   @id @default(cuid())
  orderId   String?
  action    String
  detail    String?
  actor     String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([createdAt])
}

/// A seasonal campaign that re-skins the site for a gift occasion.
///
/// Windows repeat every year, so they are stored as month/day rather than full
/// dates — 8 март is 8 март forever. A window may wrap the new year (Коледа
/// runs 20 Nov – 24 Dec, but a "26 Dec – 6 Jan" one has to work too).
model Campaign {
  id       String  @id @default(cuid())
  name     String
  enabled  Boolean @default(true)

  /// Inclusive start, 1-12 / 1-31.
  startMonth Int
  startDay   Int
  /// Inclusive end. If it sorts before the start, the window wraps the year.
  endMonth   Int
  endDay     Int

  /// When two windows overlap, the higher number wins.
  priority Int @default(0)

  /// Poster template this occasion sells. The hero CTA deep-links to the wizard
  /// with it preselected, so a "подарък за колежка" campaign never drops the
  /// visitor onto a form asking for a child's age. Null keeps the default pick.
  template PosterTemplate?

  /// Site copy overrides. Empty means "leave the default alone".
  heroTitle    String?
  heroSubtitle String?
  heroBadge    String?
  promoText    String?
  promoSecondary String?

  /// SEO overrides for the home page.
  seoTitle       String?
  seoDescription String?

  /// oklch() values applied as CSS variables — see lib/campaigns.ts.
  accentColor String?
  auraColor   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

/// Passwordless access to a customer's own past orders.
///
/// Checkout is guest-only on purpose — accounts cost conversion. A short-lived
/// emailed token gives a returning customer their stored designs without ever
/// introducing a password.
model AccessToken {
  token     String   @id
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// Durable rate-limit counters.
///
/// The in-memory limiter only protects a single Node process. On serverless
/// every invocation can be a fresh instance with an empty map, so the effective
/// limit became "N per instance" — useless against someone refreshing to burn
/// AI credit. This table is shared by all instances.
model RateLimit {
  /// e.g. "generate:<ipHash>:2026-07-29" — never a raw IP.
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/// Editable site settings (key/value) so copy and toggles live in the DB.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
