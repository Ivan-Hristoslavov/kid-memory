generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  CREATED
  GENERATING
  PREVIEW_READY
  CONFIRMED
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductType {
  DIGITAL
  POSTER_A4
  POSTER_A3
  PREMIUM
  /// Personalised book, delivered as a print-ready PDF.
  BOOK_PDF
  /// Personalised book, printed and shipped. The primary book product.
  BOOK_PRINTED
}

enum Courier {
  ECONT
  SPEEDY
}

enum DeliveryMethod {
  OFFICE
  ADDRESS
  LOCKER
}

enum Gender {
  BOY
  GIRL
}

/// What kind of poster an order is.
///
/// The shop started as children-only, which capped it to a handful of dates a
/// year. A template decides what the wizard asks for, what the AI is told to
/// draw, and which occasions the poster is sold against — everything else
/// (photo, styles, printing, delivery) is shared.
///
/// KID_WORDS is the original product and stays the default so every existing
/// order keeps its meaning without a data migration.
enum PosterTemplate {
  /// Дете + бисери (грешно казани думички).
  KID_WORDS
  /// Всеки човек + негови реплики — колега, приятел, учител, шеф.
  PORTRAIT_LINES
  /// Двойка + общи реплики — годишнина, сватба, Свети Валентин.
  COUPLE
  /// Домашен любимец + характерни му неща.
  PET
  /// Новородено + данни от раждането.
  BABY_STATS
}

enum PaymentMethod {
  COD
  STRIPE
  REVOLUT
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber Int         @unique @default(autoincrement())
  status      OrderStatus @default(CREATED)

  /// Which poster this is. Drives the wizard, the prompt and the emails.
  template PosterTemplate @default(KID_WORDS)

  // Poster input
  childName   String // combined label for title/emails (e.g. "Мила и Борис")
  /// Age of the first subject. Null on templates that have no age (a colleague
  /// is not asked how old they are, a dog's age is optional).
  childAge    Float?
  /// Gender of the first subject. Null wherever the template doesn't ask.
  childGender Gender?
  /// LEGACY, KID_WORDS only: [{ name, age, gender, words: [{word, saidAs}] }].
  /// Read through `orderSubjects()` — never directly.
  children    Json     @default("[]")
  /// Canonical, template-agnostic subject data:
  /// [{ name, age?, gender?, relation?, species?, lines: [{text, sub?, visual?}] }]
  /// Empty on orders placed before templates existed; `orderSubjects()` maps
  /// `children` across for those.
  subjects    Json     @default("[]")
  photoKey    String? // private storage key of uploaded photo
  /// What the vision pre-pass saw in the photo, captured at upload:
  /// { faces, subjects: [{ position, kind, features, hair, clothing, glasses }] }.
  /// Null on orders whose photo predates the pre-pass or whose reading failed —
  /// generation falls back to the generic identity lock for those.
  photoDescription Json?
  words       Json // flattened [{ word, saidAs }] across all subjects
  animals     String[]
  style       String

  // Product & payment
  productType   ProductType?
  addons        String[] // selected add-on ids (FRAME, PHOTO_PAPER, GIFT_WRAP)
  priceEUR      Decimal?      @db.Decimal(10, 2) // total incl. add-ons
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  /// Provider-side reference — the Stripe Checkout Session id. Unique, so a
  /// webhook Stripe retries (it retries on any non-2xx, and on timeouts it may
  /// deliver twice regardless) cannot be applied to the order a second time.
  paymentRef    String?       @unique
  /// When the money actually arrived. Null for every unpaid order, including
  /// COD orders in transit — those are only paid once the courier settles.
  paidAt        DateTime?

  /// Captured before generation so an abandoned poster can be recovered.
  leadEmail    String?

  /// Set once the recovery email for an abandoned poster has gone out.
  recoveryEmailAt DateTime?

  /// Stamped when the post-delivery review request goes out, so it fires once.
  reviewRequestAt DateTime?

  /// Explicit consent for seasonal campaign emails. Separate from the
  /// transactional mail a customer gets regardless — never assume it.
  marketingOptIn Boolean @default(false)

  /// Optional. Drives a reminder three weeks before the next birthday, which is
  /// the only occasion spread evenly across the year.
  childBirthday       DateTime?
  birthdayReminderAt  DateTime?

  /// One-click confirmation from the order email. Nothing goes to print until
  /// `confirmedAt` is set — an unclaimed personalised parcel is a total loss.
  confirmToken String?   @unique
  confirmedAt  DateTime?

  /// What the AI generations for this order actually cost us, so margin is
  /// visible per order instead of only as a monthly API bill.
  aiCostEUR   Decimal? @db.Decimal(10, 4)
  /// Number of generations, including regenerations and failed attempts.
  aiRuns      Int      @default(0)

  // Customer (guest checkout — filled at /order)
  customerName String?
  phone        String?
  email        String?
  city         String?
  address      String?

  // Delivery
  courier        Courier?
  deliveryMethod DeliveryMethod?
  courierOffice  String?
  trackingNumber String?

  /// Set when this order sells a personalised book rather than a poster.
  /// Nullable and unique: every existing poster order keeps `null`, and a book
  /// can only be sold once. The poster columns above stay filled on a book
  /// order too (childName holds the characters' names, style the art style),
  /// so admin, emails and the courier flow need no book-specific branch.
  bookId String? @unique
  book   Book?   @relation(fields: [bookId], references: [id])

  // Generated assets (private storage keys, never public URLs)
  previewImage String?
  finalImage   String?
  finalPdf     String?

  emailsSent Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([template, createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Customer review — submitted publicly, shown on the site only once approved.
model Review {
  id          String       @id @default(cuid())
  authorName  String
  city        String?
  rating      Int // 1..5
  text        String
  status      ReviewStatus @default(PENDING)
  orderNumber Int? // optional link to a real order, for verification
  featured    Boolean      @default(false)
  adminNote   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
}

/// Phone numbers that refused a cash-on-delivery parcel. A personalised poster
/// that comes back cannot be resold, so a repeat offender must be flagged at
/// checkout rather than quietly costing us a second parcel.
model BlockedPhone {
  /// Digits only, no country prefix — matching is done on the last 8.
  phone     String   @id
  reason    String?
  orderRef  Int?
  createdAt DateTime @default(now())
}

/// Audit trail for admin actions on an order.
model AdminLog {
  id        String   @id @default(cuid())
  orderId   String?
  action    String
  detail    String?
  actor     String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([createdAt])
}

/// A seasonal campaign that re-skins the site for a gift occasion.
///
/// Windows repeat every year, so they are stored as month/day rather than full
/// dates — 8 март is 8 март forever. A window may wrap the new year (Коледа
/// runs 20 Nov – 24 Dec, but a "26 Dec – 6 Jan" one has to work too).
model Campaign {
  id       String  @id @default(cuid())
  name     String
  enabled  Boolean @default(true)

  /// Inclusive start, 1-12 / 1-31.
  startMonth Int
  startDay   Int
  /// Inclusive end. If it sorts before the start, the window wraps the year.
  endMonth   Int
  endDay     Int

  /// When two windows overlap, the higher number wins.
  priority Int @default(0)

  /// Poster template this occasion sells. The hero CTA deep-links to the wizard
  /// with it preselected, so a "подарък за колежка" campaign never drops the
  /// visitor onto a form asking for a child's age. Null keeps the default pick.
  template PosterTemplate?

  /// Site copy overrides. Empty means "leave the default alone".
  heroTitle    String?
  heroSubtitle String?
  heroBadge    String?
  promoText    String?
  promoSecondary String?

  /// SEO overrides for the home page.
  seoTitle       String?
  seoDescription String?

  /// oklch() values applied as CSS variables — see lib/campaigns.ts.
  accentColor String?
  auraColor   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

/// Passwordless access to a customer's own past orders.
///
/// Checkout is guest-only on purpose — accounts cost conversion. A short-lived
/// emailed token gives a returning customer their stored designs without ever
/// introducing a password.
model AccessToken {
  token     String   @id
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// Durable rate-limit counters.
///
/// The in-memory limiter only protects a single Node process. On serverless
/// every invocation can be a fresh instance with an empty map, so the effective
/// limit became "N per instance" — useless against someone refreshing to burn
/// AI credit. This table is shared by all instances.
model RateLimit {
  /// e.g. "generate:<ipHash>:2026-07-29" — never a raw IP.
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/// Editable site settings (key/value) so copy and toggles live in the DB.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 * Personalised children's books
 *
 * The second product line. A book shares almost everything with a poster —
 * the photo upload, the vision pre-pass, the image provider, private storage,
 * checkout, delivery, payment and the admin queue — and differs in exactly two
 * places: it needs a written story before any picture exists, and it needs
 * twenty-odd illustrations of the SAME child instead of one.
 *
 * That second difference is why a book is its own aggregate rather than a
 * `PosterTemplate` variant: a poster is one synchronous generation inside a
 * request, a book is a long-running job with per-page state that has to survive
 * a serverless function ending. Everything downstream of "the artwork exists"
 * is deliberately NOT duplicated — an ordered book creates a normal `Order`
 * row, so checkout, couriers, payments, emails and the admin panel keep
 * working with no book-specific branches.
 * ------------------------------------------------------------------ */

enum BookStatus {
  /// Being filled in by the customer; nothing generated yet.
  DRAFT
  /// Story and/or illustrations in flight. See BookGeneration for progress.
  GENERATING
  /// Every page has artwork. The customer can flip through and order.
  READY
  /// An Order has been placed against it.
  ORDERED
  PRINTING
  SHIPPED
  COMPLETED
  /// Generation failed in a way the customer cannot retry past.
  FAILED
}

/// What a page is, so the PDF and the previewer can lay it out without
/// guessing from the page number.
enum BookPageKind {
  COVER
  DEDICATION
  STORY
  BACK_COVER
}

enum BookPageStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum BookAgeGroup {
  AGE_3_5
  AGE_5_7
  AGE_7_9
}

enum BookMood {
  FUNNY
  MAGICAL
  ADVENTUROUS
  CALM
  EDUCATIONAL
}

/// Which half of the pipeline a job is running, so a resumed worker knows
/// whether it still owes a story or only pictures.
enum BookJobKind {
  STORY
  ILLUSTRATIONS
  /// A single page the customer asked to redraw.
  PAGE
  PDF
}

enum BookJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model Book {
  id         String     @id @default(cuid())
  bookNumber Int        @unique @default(autoincrement())
  status     BookStatus @default(DRAFT)

  // ---- What the customer asked for -------------------------------------
  /// Catalog id from lib/books/catalog.ts. A String rather than an enum
  /// because adventures grow with the seasons, exactly like poster `style`.
  adventure  String
  /// Free-text "my own idea", used verbatim in the story prompt when set.
  customIdea String?
  ageGroup   BookAgeGroup @default(AGE_5_7)
  mood       BookMood     @default(MAGICAL)
  /// "баба", "кучето Боби", "морето" — things the story must contain.
  mustInclude String[]
  /// Catalog id from lib/books/catalog.ts. Fixed for the whole book: every
  /// page has to be drawn in one visual universe.
  artStyle   String
  /// How the children relate to one another, in the parent's own words. Only
  /// meaningful with more than one character, and genuinely used by the story
  /// prompt rather than merely stored.
  relationships String?
  /// Printed on its own page near the front.
  dedication String?

  // ---- What the AI produced --------------------------------------------
  title    String?
  subtitle String?
  /// The structured story exactly as the model returned it, before it was
  /// split into BookPage rows. Kept so a story can be re-split or audited
  /// without a second paid generation.
  story    Json?

  // ---- Assets (private storage keys, never public URLs) -----------------
  coverImage String?
  finalPdf   String?

  /// Guest-first, like the poster shop: no accounts, an emailed AccessToken
  /// is how a customer returns to their own books. See the AccessToken model.
  leadEmail String?

  /// What this book actually cost us in AI, and how many generations it took
  /// including regenerations — a book is ~24 images, so per-unit margin has to
  /// be visible or a fussy customer quietly eats the whole of it.
  aiCostEUR Decimal? @db.Decimal(10, 4)
  aiRuns    Int      @default(0)

  characters  BookCharacter[]
  pages       BookPage[]
  generations BookGeneration[]
  order       Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([leadEmail])
}

/// One child starring in a book.
///
/// `referenceSheet` is the whole reason a book looks like one child rather than
/// twenty cousins: the vision pre-pass writes the face down once, and every
/// page prompt spends that same description alongside the same source photo.
model BookCharacter {
  id     String @id @default(cuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  /// Position in the wizard, so pages can refer to "character 1" stably.
  ordinal Int

  name        String
  age         Float?
  gender      Gender?
  /// The parent's own words: "Мартин е на 5, обича динозаври, пази сестра си."
  description String?
  interests   String?
  favouriteToy    String?
  favouriteAnimal String?

  /// Private storage key of the uploaded photo.
  photoKey String?
  /// The written character sheet — appearance, hair, eyes, face, clothing,
  /// personality — produced from the photo and reused on every page prompt.
  /// Same shape discipline as Order.photoDescription: model-written text that
  /// reaches an image prompt, so it is never accepted from the browser.
  referenceSheet Json?
  /// Optional generated turnaround/reference image, if one was rendered.
  referenceImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, ordinal])
  @@index([bookId])
}

model BookPage {
  id     String @id @default(cuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  /// 1-based, covering every printed leaf including cover and dedication.
  pageNumber Int
  kind       BookPageKind   @default(STORY)
  status     BookPageStatus @default(PENDING)

  /// The story text for this page, in Bulgarian.
  text String?
  /// What the illustrator was asked to draw. Kept so a single page can be
  /// redrawn without regenerating the story around it.
  imagePrompt String?
  /// Private storage key.
  imageKey String?

  /// Why this page failed, for the admin queue.
  error String?
  /// Counts regenerations of this page alone.
  attempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, pageNumber])
  @@index([bookId, pageNumber])
  @@index([status])
}

/// One unit of long-running work on a book.
///
/// Twenty-four illustrations cannot be produced inside one HTTP request — the
/// poster's single image already takes most of a minute. A worker route claims
/// a job, does as much as it can inside its own time budget, writes progress
/// here and re-triggers itself; a cron sweeps anything left RUNNING by a
/// function that died. The customer's browser polls this row, which is what
/// "Генерираме илюстрация 7 от 24" is actually reading.
model BookGeneration {
  id     String @id @default(cuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  kind   BookJobKind
  status BookJobStatus @default(QUEUED)

  /// For a PAGE job, which page. Null for whole-book jobs.
  pageNumber Int?

  /// Progress, for the customer-facing message.
  done  Int @default(0)
  total Int @default(0)

  /// Set while a worker holds the job, so a sweep can tell "in flight" from
  /// "abandoned by a function that timed out".
  claimedAt DateTime?
  error     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([bookId, kind])
}
